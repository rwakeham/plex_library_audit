# Copy to .env, or run ./setup.sh, which writes .env for you.

# Plex auth token. Read by the app only; never logged, never sent to the browser.
PLEX_TOKEN=your-plex-token
# Plex server the app reads from.
PLEX_BASE_URL=http://172.16.19.6:32400
# Host port the dashboard is published on. setup.sh picks the first free port from 8300.
PORT=8300
# Seconds to cache the library between Plex fetches.
CACHE_TTL=300
